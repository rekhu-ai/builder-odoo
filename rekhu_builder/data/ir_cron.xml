<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- forgets the platform's old call signatures, and reports the tools again in direct mode -->
    <record id="ir_cron_rekhu_builder_hourly" model="ir.cron">
        <field name="name">Rekhu Builder: keep the connection</field>
        <field name="model_id" ref="model_rekhu_builder_seen"/>
        <field name="state">code</field>
        <field name="code">model._rekhu_hourly()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
